name: CI Pipeline

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  build:
    # Use your self-hosted runner
    runs-on: self-hosted

    steps:
    # Step 1: Checkout the repository
    - name: Checkout repository
      uses: actions/checkout@v3
      with:
        ref: main

    # Step 2: Set up Java (adjust the version if needed)
    - name: Set up JDK 17
      uses: actions/setup-java@v3
      with:
        java-version: '17'

    # Step 3: Build Maven project
    - name: Build Maven Project
      run: mvn clean package

    # Step 4: Build Docker image
    - name: Build Docker Image
      run: docker build -t ganeshcgi/testapp:latest .

    # Step 5: Run Docker container
    - name: Run Docker Container
      run: |
        docker stop testapp || true
        docker rm testapp || true
        docker run -d --name testapp -p 8080:8080 ganeshcgi/testapp:latest

    # Step 6: Clean up workspace
    - name: Clean workspace
      run: rm -rf *

